% techref-notation.sty -- notation of the TwoPhaseAMR.jl technical reference.
%
% Every symbol that carries a meaning is a macro defined here exactly once.
% Chapters, worked samples and TikZ labels use these macros only, so the
% notation can be changed in one place. Thesis macros (Remmerswaal 2023,
% preamble.tex, notation block) keep their names and renderings.
%
% \DefineNotation[n]{\cs}{body}{sample}{meaning}{code}{thesis}
%   defines \cs with n arguments AND records a row of the notation table
%   (Appendix "Notation", \PrintNotationTable). <sample> is \cs applied to
%   typical arguments, <code> the corresponding code names and <thesis> the
%   thesis location, or "new" for notation added by this reference.
% \NotationGroup{key}{title} starts the next table group.
% Formatting helpers that carry no meaning use plain \newcommand.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{techref-notation}[2026/11/08 Thesis notation with AMR extension]
\RequirePackage{amsmath,amssymb,mathtools,bm}
\RequirePackage{stackengine}
\RequirePackage{stmaryrd}
% stmaryrd has no bold series; map it explicitly (avoids a font warning
% whenever bold math, e.g. \bm, is used).
\SetSymbolFont{stmry}{bold}{U}{stmry}{m}{n}

% ---------------------------------------------------------------------------
% Registry
% ---------------------------------------------------------------------------
\newcommand\techref@groups{}
\newcommand\techref@group{}
\newcommand\NotationGroup[2]{%
  \def\techref@group{#1}%
  \expandafter\gdef\csname techref@title@#1\endcsname{#2}%
  \expandafter\gdef\csname techref@rows@#1\endcsname{}%
  \g@addto@macro\techref@groups{\techref@printgroup{#1}}%
}
\newcommand\DefineNotation[7][0]{%
  \newcommand#2[#1]{#3}%
  \expandafter\g@addto@macro\csname techref@rows@\techref@group\endcsname
    {\NotationRow{#4}{#5}{#6}{#7}}%
}
\newcommand\techref@printgroup[1]{%
  \multicolumn{4}{@{}l}{\normalsize\scshape\csname techref@title@#1\endcsname}%
  \\*\addlinespace[1pt]%
  \csname techref@rows@#1\endcsname
  \addlinespace[6pt]%
}
% One table row; redefine to change the layout of the generated table.
\newcommand\NotationRow[4]{$\displaystyle #1$ & #2 & #3 & #4\\}
% Requires longtable, array and booktabs (loaded by techref.tex).
\providecommand\NotationTableSetup{}
\newcommand\PrintNotationTable{%
  \begingroup\small\setlength\tabcolsep{4pt}\NotationTableSetup
  \begin{longtable}{@{}>{\raggedright}p{2.1cm}>{\raggedright}p{5.15cm}%
      >{\raggedright\scriptsize}p{3.55cm}>{\raggedright\arraybackslash}p{1.25cm}@{}}
    \toprule
    Symbol & Meaning & Code & Thesis\\
    \midrule
    \endfirsthead
    \toprule
    Symbol & Meaning & Code & Thesis\\
    \midrule
    \endhead
    \bottomrule
    \endfoot
    \techref@groups
  \end{longtable}
  \endgroup
}

% ---------------------------------------------------------------------------
% Formatting primitives of the thesis (no table entry)
% ---------------------------------------------------------------------------
\newcommand{\+}[1]{\bm{#1}}                       % bold vector or tensor
\newcommand\roundpar[1]{\left( #1 \right)}
\newcommand\squarepar[1]{\left[ #1 \right]}
\newcommand\curlypar[1]{\left\lbrace #1 \right\rbrace}
\newcommand\abs[1]{\left\lvert #1 \right\rvert}   % absolute value
\newcommand\norm[1]{\lVert #1 \rVert}
\newcommand*\dd{\mathop{}\!\mathrm{d}}
\newcommand\integral[3]{\int_{#1} #2 \dd #3}
\newcommand\eqdef{=\mathrel{\mathop:}}
\newcommand\defeq{\mathrel{\mathop:}=}
\newcommand\half{\frac{1}{2}}
\newcommand\set[2]{\{\,#1 \mid #2\,\}}
\newcommand\mtext[1]{\text{\normalfont\scshape #1}}
\newcommand\cvset[1]{\mathcal{#1}}                % set of control volumes
\stackMath
\newcommand\funspace[1]{\stackon[-1pt]{\mathcal{#1}}{\scriptstyle\rightharpoonup}}
\newcommand\setextrusion[1]{{\omega(\mathcal{#1})}}
\newcommand\sym[1]{\operatorname{sym}\roundpar{#1}} % (A + A^T)/2
\newcommand\diag[1]{\operatorname{diag}\roundpar{#1}}
\newcommand*{\@transpose}[2]{\raisebox{\depth}{$\m@th#1\intercal$}}
\NewDocumentCommand{\dgal}{sO{}m}{%
  \IfBooleanTF{#1}{\dgalext{#3}}{\dgalx[#2]{#3}}%
}
\NewDocumentCommand{\dgalext}{m}{%
  \sbox0{\mathsurround=0pt$\left\{\vphantom{#1}\right.\kern-\nulldelimiterspace$}%
  \sbox2{\{}%
  \ifdim\ht0=\ht2
    \{\kern-.625\wd2 \{#1\}\kern-.625\wd2 \}%
  \else
    \left\{\kern-.7\wd0\left\{#1\right\}\kern-.7\wd0\right\}%
  \fi
}
\NewDocumentCommand{\dgalx}{om}{%
  \sbox0{\mathsurround=0pt$#1\{$}\sbox2{\{}%
  \ifdim\ht0=\ht2
    \{\kern-.625\wd2 \{#2\}\kern-.625\wd2 \}%
  \else
    \mathopen{#1\{\kern-.7\wd0 #1\{}#2%
    \mathclose{#1\}\kern-.7\wd0 #1\}}%
  \fi
}

