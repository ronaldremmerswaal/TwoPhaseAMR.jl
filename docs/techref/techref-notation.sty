% As in the thesis, this is a sum, not an arithmetic average.
\newcommand\mean[1]{\dgal*{#1}}
\NewDocumentCommand{\dgal}{sO{}m}{%
  \IfBooleanTF{#1}{\dgalext{#3}}{\dgalx[#2]{#3}}%
}
\NewDocumentCommand{\dgalext}{m}{%
  \sbox0{\mathsurround=0pt$\left\{\vphantom{#1}\right.\kern-\nulldelimiterspace$}%
  \sbox2{\{}%
  \ifdim\ht0=\ht2
    \{\kern-.625\wd2 \{#1\}\kern-.625\wd2 \}%
  \else
    \left\{\kern-.7\wd0\left\{#1\right\}\kern-.7\wd0\right\}%
  \fi
}
\NewDocumentCommand{\dgalx}{om}{%
  \sbox0{\mathsurround=0pt$#1\{$}\sbox2{\{}%
  \ifdim\ht0=\ht2
    \{\kern-.625\wd2 \{#2\}\kern-.625\wd2 \}%
  \else
    \mathopen{#1\{\kern-.7\wd0 #1\{}#2%
    \mathclose{#1\}\kern-.7\wd0 #1\}}%
  \fi
}
