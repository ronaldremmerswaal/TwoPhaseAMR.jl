{
  "name": "two-phase-amr-studio-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "24.13.0",
    "npm": "11.6.2"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "check:bundle": "node scripts/build.mjs --check",
    "test": "vitest",
    "test:smoke": "node smoke/smoke.mjs",
    "test:examples": "node smoke/pr2.mjs && npm run test:continue",
    "test:live-amr": "node smoke/live-amr.mjs && npm run test:header-stability",
    "test:header-stability": "node smoke/header-stability.mjs",
    "test:continue": "node smoke/continue.mjs",
    "bench:renderer": "node smoke/performance.mjs",
    "test:time-linear": "node smoke/time-linear.mjs"
  },
  "dependencies": {
    "dockview": "8.8.3",
    "dockview-core": "8.8.3",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "24.10.1",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
